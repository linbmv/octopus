FROM gcr.io/distroless/base-debian12:debug-nonroot@sha256:cc16fee1b4f000807c12da1353c7d265f9cded1e54c60a5dd319f38619684a51

ARG TARGETPLATFORM
ENV TZ=Asia/Shanghai

COPY --chown=10001:10001 --chmod=0555 build/docker/${TARGETPLATFORM}/octopus /app/octopus
COPY --chown=10001:10001 scripts/dockerfiles/volume-seed/ /app/data/
COPY --chown=0:0 --chmod=0555 scripts/dockerfiles/entrypoint.sh /entrypoint.sh

WORKDIR /app
VOLUME ["/app/data"]
EXPOSE 8080

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/busybox/sh", "-ec", "exec /busybox/wget -q -T 3 -O /dev/null \"http://127.0.0.1:${OCTOPUS_SERVER_PORT:-8080}/health\""]

STOPSIGNAL SIGTERM
ENTRYPOINT ["/busybox/sh", "/entrypoint.sh"]
