FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG TARGETPLATFORM
ENV TZ=Asia/Shanghai

RUN apk add --no-cache --upgrade ca-certificates curl su-exec tzdata && \
    ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" >/etc/timezone && \
    addgroup -S -g 10001 octopus && \
    adduser -S -D -H -u 10001 -G octopus -s /sbin/nologin octopus && \
    mkdir -p /app/data && \
    chown 10001:10001 /app/data

COPY build/docker/${TARGETPLATFORM}/octopus /app/octopus
COPY scripts/dockerfiles/entrypoint.sh /entrypoint.sh

RUN chmod 0555 /app/octopus /entrypoint.sh

WORKDIR /app
VOLUME ["/app/data"]
EXPOSE 8080

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error --max-time 3 \
        "http://127.0.0.1:${OCTOPUS_SERVER_PORT:-8080}/health" >/dev/null || exit 1

STOPSIGNAL SIGTERM
ENTRYPOINT ["/entrypoint.sh"]
